<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Outil de démo : démarre le routeur et les cellules, chacun dans son processus (comme le ferait un orchestrateur).
    Toutes les cellules sont le MÊME programme, lancé avec un identifiant et un port différents.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Garantit que le routeur et les cellules sont compilés avant le lanceur, sans en dépendre au niveau du code. -->
  <ItemGroup>
    <ProjectReference Include="..\Cell.Routeur\Cell.Routeur.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Cell.Cellule\Cell.Cellule.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
