  -->

  <ItemGroup>
    <ProjectReference Include="..\Styles.Banque\Styles.Banque.csproj" />
    <ProjectReference Include="..\Styles.Contrats\Styles.Contrats.csproj" />
  </ItemGroup>

</Project>
