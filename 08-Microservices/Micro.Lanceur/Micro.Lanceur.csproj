<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Outil de démo : démarre chaque service dans son propre processus (comme le ferait un orchestrateur :
    docker compose, Kubernetes, .NET Aspire…). Ce n'est pas un service de la banque.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Garantit que les services sont compilés avant le lanceur, sans en dépendre au niveau du code. -->
  <ItemGroup>
    <ProjectReference Include="..\Micro.Courtier\Micro.Courtier.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Micro.Comptes\Micro.Comptes.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Micro.Virements\Micro.Virements.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Micro.Notifications\Micro.Notifications.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Micro.Passerelle\Micro.Passerelle.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
