<!DOCTYPE html>
@* The common layout: each view is inserted in place of RenderBody(). *@
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — MVC Bank</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 46rem; margin: 2rem auto; padding: 0 1rem; color: #1f2933; }
        header { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid #cbd2d9; margin-bottom: 1.5rem; }
        header a { color: inherit; text-decoration: none; }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: .45rem .5rem; border-bottom: 1px solid #e4e7eb; }
        td.amount, th.amount { text-align: right; font-variant-numeric: tabular-nums; }
        .debit { color: #b42318; }
        .message { background: #e3f9e5; border: 1px solid #57ae5b; padding: .6rem .8rem; border-radius: .3rem; }
        .validation-summary-errors, .field-validation-error { color: #b42318; }
        .input-validation-error { border-color: #b42318; }
        form div { margin-bottom: .9rem; }
        label { display: block; font-weight: 600; margin-bottom: .2rem; }
        input, select { font: inherit; padding: .3rem; min-width: 18rem; border: 1px solid #9aa5b1; border-radius: .2rem; }
        button, .button { font: inherit; padding: .4rem .9rem; border-radius: .3rem; border: 1px solid #2f6fb3; background: #2f6fb3; color: #fff; text-decoration: none; cursor: pointer; }
        .secondary { background: #fff; color: #2f6fb3; }
    </style>
</head>
<body>
    <header>
        <h1><a asp-controller="Accounts" asp-action="Index">MVC Bank</a></h1>
        <a class="button" asp-controller="Transfers" asp-action="New">New transfer</a>
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
