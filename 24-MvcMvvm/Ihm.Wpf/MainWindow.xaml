<!--
  LA VUE : uniquement des liaisons ({Binding …}) vers le ViewModel, qui est le DataContext.
  - Une liaison lit la propriété et s'abonne à PropertyChanged : quand le ViewModel change, l'écran suit.
  - Dans l'autre sens (TwoWay), une frappe ou une sélection écrit dans la propriété du ViewModel.
  - Command="{Binding …}" relie un bouton à une commande : clic → Execute, CanExecute → bouton actif ou grisé.
  Le compilateur ne vérifie PAS ces noms (une faute de frappe donne une liaison muette, sans erreur) :
  les d:DataContext et DataType ci-dessous disent quel type est lié où, et un test s'en sert pour tout vérifier.
-->
<Window x:Class="Ihm.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Ihm.Presentation;assembly=Ihm.Presentation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:EcranPrincipalViewModel}"
        Title="{Binding Titre}" Width="940" Height="580" Background="White"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- À gauche : les comptes et l'historique du compte sélectionné -->
        <DockPanel Grid.Column="0" DataContext="{Binding Comptes}" d:DataContext="{d:DesignInstance Type=vm:ComptesViewModel}">
            <TextBlock DockPanel.Dock="Top" Text="Comptes" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Comptes}" SelectedItem="{Binding CompteSelectionne}"
                     HorizontalContentAlignment="Stretch" BorderBrush="#CBD2D9">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CompteViewModel}">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Libelle}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Titulaire}" Foreground="#616E7C" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding SoldeAffiche}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock DockPanel.Dock="Top" Text="{Binding TitreOperations}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,6" />
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                         Visibility="{Binding ChargementEnCours, Converter={StaticResource VisibleSiVrai}}" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding Erreur}" Foreground="#B42318" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Operations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OperationViewModel}">
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Date}" Foreground="#616E7C" />
                                <TextBlock Grid.Column="1" Text="{Binding Libelle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="Montant" Grid.Column="2" Text="{Binding Montant}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding EstDebit}" Value="True">
                                    <Setter TargetName="Montant" Property="Foreground" Value="#B42318" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- À droite : le formulaire de virement -->
        <Border Grid.Column="2" BorderBrush="#CBD2D9" BorderThickness="1" CornerRadius="4" Padding="16" VerticalAlignment="Top">
            <StackPanel DataContext="{Binding Virement}" d:DataContext="{d:DesignInstance Type=vm:VirementViewModel}">
                <TextBlock Text="Virement" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

                <TextBlock Text="Compte à débiter" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Comptes}" SelectedItem="{Binding Source}" DisplayMemberPath="Affichage" Margin="0,4,0,8" />

                <TextBlock Text="Compte à créditer" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Comptes}" SelectedItem="{Binding Cible}" DisplayMemberPath="Affichage" Margin="0,4,0,2" />
                <TextBlock Text="{Binding ErreurCible}" Foreground="#B42318" TextWrapping="Wrap" />
                <Button Content="⇅ Échanger" Command="{Binding EchangerCommande}" HorizontalAlignment="Left" Padding="8,2" Margin="0,4,0,8" />

                <TextBlock Text="Montant (€)" FontWeight="SemiBold" />
                <TextBox Text="{Binding MontantSaisi, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,2" Padding="2" />
                <TextBlock Text="{Binding ErreurMontant}" Foreground="#B42318" TextWrapping="Wrap" />

                <Button Content="Virer" Command="{Binding VirerCommande}" Padding="16,6" Margin="0,12,0,8" HorizontalAlignment="Left" />
                <ProgressBar IsIndeterminate="True" Height="3"
                             Visibility="{Binding EstOccupe, Converter={StaticResource VisibleSiVrai}}" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#207227" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageEstErreur}" Value="True">
                                    <Setter Property="Foreground" Value="#B42318" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
