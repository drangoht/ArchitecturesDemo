<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    MVC (Modèle - Vue - Contrôleur), sur le web : ASP.NET Core MVC, http://localhost:5124.
    - Le CONTRÔLEUR reçoit la requête (une route), interroge le modèle, puis CHOISIT la vue et lui passe ses données.
    - La VUE (Razor, .cshtml) transforme ces données en HTML, une fois par requête ; elle ne vit pas au-delà.
    - Le MODÈLE est Ihm.Banque ; Models/ ne contient que les données taillées pour chaque vue.
    Le cycle est sans état : chaque clic est une nouvelle requête, qui reconstruit tout.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Ihm.Banque\Ihm.Banque.csproj" />
  </ItemGroup>

</Project>
