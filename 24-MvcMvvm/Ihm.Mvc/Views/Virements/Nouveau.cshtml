@model FormulaireVirement
@* Les tag helpers (asp-for…) génèrent les name, id, valeurs et messages d'erreur à partir du modèle et de ModelState :
   après une erreur, les champs reviennent remplis avec ce que l'utilisateur avait saisi, même « abc ». *@
@{
    ViewData["Titre"] = "Nouveau virement";
    var options = Model.Comptes.Select(c => new SelectListItem($"{c.Titulaire} — {c.Libelle} ({c.Solde})", c.Id.ToString()));
}

<h2>Nouveau virement</h2>
<form asp-action="Nouveau" method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <div>
        <label asp-for="Source"></label>
        <select asp-for="Source" asp-items="options"><option value="">— choisir —</option></select>
        <span asp-validation-for="Source"></span>
    </div>
    <div>
        <label asp-for="Cible"></label>
        <select asp-for="Cible" asp-items="options"><option value="">— choisir —</option></select>
        <span asp-validation-for="Cible"></span>
    </div>
    <div>
        <label asp-for="Montant"></label>
        <input asp-for="Montant" type="text" inputmode="decimal" autocomplete="off" />
        <span asp-validation-for="Montant"></span>
    </div>
    <button type="submit">Virer</button>
</form>
