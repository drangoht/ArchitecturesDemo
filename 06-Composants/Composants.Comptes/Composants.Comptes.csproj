<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Composant « Comptes » : logique métier + accès aux données derrière UNE interface publique.
    Tout le reste est internal : le compilateur interdit aux autres projets de court-circuiter le composant.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <!-- Seul le projet de tests peut voir l'intérieur (pour tester l'entité Compte directement). -->
    <InternalsVisibleTo Include="Composants.Tests" />
  </ItemGroup>

</Project>
